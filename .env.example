# Copia este archivo a .env.local para desarrollo. En Vercel, defínelas en
# Project Settings → Environment Variables.
#
# Solo valores PÚBLICOS. Nunca pongas aquí la service_role, claves sb_secret_
# ni claves de proveedores de IA: esas viven en Supabase (Edge Functions/Vault).

NEXT_PUBLIC_SUPABASE_URL=https://owefcumdoqvtmhaksxln.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (sin barra final). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Selector de archivos de Google (públicos por diseño). La clave de API debe
# estar restringida a la Google Picker API y al dominio de la app.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Número del proyecto de Google Cloud (App ID del selector).
NEXT_PUBLIC_GOOGLE_APP_ID=

